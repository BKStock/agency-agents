{
  "rule_version": "0.1.0",
  "description": "R1〜R6・L1〜L6 初期判定ルール。すべて未承認（approved=false）のため、本版では確定（confirmed）は生成されない。",
  "threshold_origin_legend": {
    "user_specified": "指示書で利用者が提示した初期基準（未承認）",
    "proposed": "本設計の提案値。全国分布の分析後に承認が必要（未承認）"
  },
  "primary_selection": {
    "min_margin": 0.10,
    "grade_order": ["A", "B", "C"]
  },
  "near_threshold_tolerance": 0.03,
  "classes": {
    "R1": {
      "axis": "R", "kind": "primary", "name": "高級戸建住宅地", "approved": false,
      "conditions": [
        {"feature": "detached_ratio", "op": ">=", "value": 0.70, "threshold_origin": "proposed"},
        {"feature": "land_price_pref_pct", "op": ">=", "value": 0.80, "threshold_origin": "proposed"},
        {"feature": "zoning_residential_ratio", "op": ">=", "value": 0.60, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": []
    },
    "R2": {
      "axis": "R", "kind": "primary", "name": "一般戸建住宅地", "approved": false,
      "conditions": [
        {"feature": "detached_ratio", "op": ">=", "value": 0.70, "threshold_origin": "user_specified"},
        {"feature": "zoning_residential_ratio", "op": ">=", "value": 0.50, "threshold_origin": "proposed"}
      ],
      "exclude_if_class": ["R1"],
      "confirm_requires_evidence": []
    },
    "R3": {
      "axis": "R", "kind": "primary", "name": "分譲マンション中心", "approved": false,
      "conditions": [
        {"feature": "apartment_ratio", "op": ">=", "value": 0.65, "threshold_origin": "user_specified"},
        {"feature": "owner_ratio", "op": ">=", "value": 0.50, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": ["tenure_by_structure_owner", "condo_register", "plateau_condo_use"]
    },
    "R4": {
      "axis": "R", "kind": "primary", "name": "賃貸マンション中心", "approved": false,
      "conditions": [
        {"feature": "apartment_ratio", "op": ">=", "value": 0.65, "threshold_origin": "user_specified"},
        {"feature": "rental_ratio", "op": ">=", "value": 0.50, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": ["tenure_by_structure_rental", "rental_building_register", "plateau_rental_use"]
    },
    "R5": {
      "axis": "R", "kind": "primary", "name": "団地・大規模集合住宅", "approved": false,
      "conditions": [
        {"feature": "apartment_ratio", "op": ">=", "value": 0.65, "threshold_origin": "proposed"},
        {"feature": "public_rental_ratio", "op": ">=", "value": 0.30, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": ["public_housing_site", "ur_estate", "large_estate_register"]
    },
    "R6": {
      "axis": "R", "kind": "primary", "name": "住宅・商業混在地区", "approved": false,
      "conditions": [
        {"feature": "households_general", "op": ">=", "value": 50, "threshold_origin": "proposed"},
        {"feature": "estab_per_household", "op": ">=", "value": 0.15, "threshold_origin": "proposed"},
        {"feature": "zoning_commercial_ratio", "op": ">=", "value": 0.20, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": []
    },
    "L1": {
      "axis": "L", "kind": "primary", "name": "農村集落", "approved": false,
      "conditions": [
        {"feature": "agri_settlement_overlap", "op": ">=", "value": 0.50, "threshold_origin": "proposed"},
        {"feature": "farmland_ratio", "op": ">=", "value": 0.20, "threshold_origin": "proposed"},
        {"feature": "did_flag", "op": "==", "value": 0, "threshold_origin": "proposed"},
        {"feature": "households_general", "op": ">=", "value": 1, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": []
    },
    "L2": {
      "axis": "L", "kind": "primary", "name": "漁村集落", "approved": false,
      "conditions": [
        {"feature": "fishery_settlement_overlap", "op": ">=", "value": 0.30, "threshold_origin": "proposed"},
        {"feature": "did_flag", "op": "==", "value": 0, "threshold_origin": "proposed"},
        {"feature": "households_general", "op": ">=", "value": 1, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": []
    },
    "L3": {
      "axis": "L", "kind": "primary", "name": "山間集落", "approved": false,
      "conditions": [
        {"feature": "forest_ratio", "op": ">=", "value": 0.60, "threshold_origin": "proposed"},
        {"feature": "slope_mean_deg", "op": ">=", "value": 8.0, "threshold_origin": "proposed"},
        {"feature": "did_flag", "op": "==", "value": 0, "threshold_origin": "proposed"},
        {"feature": "households_general", "op": ">=", "value": 1, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": []
    },
    "L4": {
      "axis": "L", "kind": "primary", "name": "地方都市住宅地", "approved": false,
      "conditions": [
        {"feature": "metro_core_flag", "op": "==", "value": 0, "threshold_origin": "proposed"},
        {"feature": "uea_member", "op": "==", "value": 1, "threshold_origin": "proposed"},
        {"feature": "zoning_residential_ratio", "op": ">=", "value": 0.50, "threshold_origin": "proposed"},
        {"feature": "pop_density", "op": ">=", "value": 1000, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": []
    },
    "L5": {
      "axis": "L", "kind": "primary", "name": "別荘・リゾート住宅地", "approved": false,
      "conditions": [
        {"feature": "vacation_home_share_muni", "op": ">=", "value": 0.05, "threshold_origin": "proposed"}
      ],
      "confirm_requires_evidence": ["vacation_home_register", "plateau_villa_use", "municipal_resort_document"]
    },
    "L6": {
      "axis": "L", "kind": "attribute", "name": "過疎・高齢化集落", "approved": false,
      "conditions": [
        {"feature": "aging_rate", "op": ">=", "value": 0.40, "threshold_origin": "user_specified"},
        {"feature": "pop_change_10y", "op": "<=", "value": -0.20, "threshold_origin": "user_specified"}
      ],
      "context_any": [
        {"class": "L1"}, {"class": "L2"}, {"class": "L3"},
        {"feature": "did_flag", "op": "==", "value": 0}
      ],
      "confirm_requires_evidence": []
    }
  }
}
