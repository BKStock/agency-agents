{
  "rule_version": "2026.10-draft",
  "note": "R1〜R6・L1〜L6 初期ルール。全分類 approved=false（確定は出ない）。条件は [特徴量, 演算子, 閾値, 出所]。出所 user=指示書の利用者指定（未承認）, proposed=本設計の提案（未承認）, approved=承認済み。",
  "min_margin": 0.10,
  "near_tolerance": 0.03,
  "grade_order": ["A", "B", "C"],
  "classes": {
    "R1": {"axis": "R", "role": "main", "name": "高級戸建住宅地", "approved": false,
           "all": [["detached_ratio", ">=", 0.70, "proposed"], ["land_price_pref_pct", ">=", 0.80, "proposed"],
                   ["zoning_residential_ratio", ">=", 0.60, "proposed"]]},
    "R2": {"axis": "R", "role": "main", "name": "一般戸建住宅地", "approved": false,
           "all": [["detached_ratio", ">=", 0.70, "user"], ["zoning_residential_ratio", ">=", 0.50, "proposed"]],
           "excludes": ["R1"]},
    "R3": {"axis": "R", "role": "main", "name": "分譲マンション中心", "approved": false,
           "all": [["apartment_ratio", ">=", 0.65, "user"], ["owner_ratio", ">=", 0.50, "proposed"]],
           "confirm_evidence": ["tenure_by_structure_owner", "condo_register", "plateau_condo_use"]},
    "R4": {"axis": "R", "role": "main", "name": "賃貸マンション中心", "approved": false,
           "all": [["apartment_ratio", ">=", 0.65, "user"], ["rental_ratio", ">=", 0.50, "proposed"]],
           "confirm_evidence": ["tenure_by_structure_rental", "rental_building_register", "plateau_rental_use"]},
    "R5": {"axis": "R", "role": "main", "name": "団地・大規模集合住宅", "approved": false,
           "all": [["apartment_ratio", ">=", 0.65, "proposed"], ["public_rental_ratio", ">=", 0.30, "proposed"]],
           "confirm_evidence": ["public_housing_site", "ur_estate", "large_estate_register"]},
    "R6": {"axis": "R", "role": "main", "name": "住宅・商業混在地区", "approved": false,
           "all": [["households_general", ">=", 50, "proposed"], ["estab_per_household", ">=", 0.15, "proposed"],
                   ["zoning_commercial_ratio", ">=", 0.20, "proposed"]]},
    "L1": {"axis": "L", "role": "main", "name": "農村集落", "approved": false,
           "all": [["agri_settlement_overlap", ">=", 0.50, "proposed"], ["farmland_ratio", ">=", 0.20, "proposed"],
                   ["did_flag", "==", 0, "proposed"], ["households_general", ">=", 1, "proposed"]]},
    "L2": {"axis": "L", "role": "main", "name": "漁村集落", "approved": false,
           "all": [["fishery_settlement_overlap", ">=", 0.30, "proposed"], ["did_flag", "==", 0, "proposed"],
                   ["households_general", ">=", 1, "proposed"]]},
    "L3": {"axis": "L", "role": "main", "name": "山間集落", "approved": false,
           "all": [["forest_ratio", ">=", 0.60, "proposed"], ["slope_mean_deg", ">=", 8.0, "proposed"],
                   ["did_flag", "==", 0, "proposed"], ["households_general", ">=", 1, "proposed"]]},
    "L4": {"axis": "L", "role": "main", "name": "地方都市住宅地", "approved": false,
           "all": [["metro_core_flag", "==", 0, "proposed"], ["uea_member", "==", 1, "proposed"],
                   ["zoning_residential_ratio", ">=", 0.50, "proposed"], ["pop_density", ">=", 1000, "proposed"]]},
    "L5": {"axis": "L", "role": "main", "name": "別荘・リゾート住宅地", "approved": false,
           "all": [["vacation_home_share_muni", ">=", 0.05, "proposed"]],
           "confirm_evidence": ["vacation_home_register", "plateau_villa_use", "municipal_resort_document"]},
    "L6": {"axis": "L", "role": "attribute", "name": "過疎・高齢化集落", "approved": false,
           "all": [["aging_rate", ">=", 0.40, "user"], ["pop_change_10y", "<=", -0.20, "user"]],
           "context_any": [{"class": "L1"}, {"class": "L2"}, {"class": "L3"}, {"feature": ["did_flag", "==", 0]}]}
  }
}
